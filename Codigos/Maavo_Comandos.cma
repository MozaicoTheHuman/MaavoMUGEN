[State -1, Ai Recover]
type = ChangeState
value = cond(pos y <= -20,5210,5200)
triggerall = aiLevel && roundstate = 2 && alive && numenemy
triggerall = enemynear,ailevel = 0 && random < var(59)*cond(life < (lifemax*.5),2,1) || enemynear,ailevel 
