trigger2 = (P2BodyDist X > 90 || enemynear,time > 50)
trigger2 = random <= cond(enemynear,aiLevel, 8, cond(aiLevel=8, 3, aiLevel))*150
trigger3 = (aiLevel >= 3 || enemynear,aiLevel)
trigger3 = enemynear,movetype != H
trigger3 = enemynear,statetype != L
trigger3 = enemynear,movetype = A
trigger3 = cond(enemynear,aiLevel, 1, random < cond(aiLevel=8, 3, aiLevel) * cond(life < lifemax*0.5, 140, 90) || (ailevel && enemynear,aiLevel))

