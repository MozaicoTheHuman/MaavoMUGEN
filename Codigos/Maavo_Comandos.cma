trigger2 = 0&&(var(59):=cond(aiLevel=1,3,cond(aiLevel=2,10,cond(aiLevel=3,20,cond(aiLevel=4,35,cond(aiLevel=5,55,cond(aiLevel=6,85,cond(aiLevel=7,90,cond(aiLevel=8,105,0)))))))))
;Store Enemy PosX then Calc Enemy TrVelX 
trigger3 = aiLevel
trigger3 = gameTime % 2 = 0
trigger3 = 0&&(var(47):=ceil(enemynear,pos x))
trigger4 = aiLevel
trigger4 = gameTime % 2 = 1
trigger4 = 0&&(var(48):=ceil(cond(abs(var(47)) - abs(enemynear,pos x) = 0, enemynear,vel x, abs(var(47)) - abs(enemynear,pos x))))
;Calc CC HitTime then Reset CC when no target
trigger5 = numtarget > 0
trigger5 = 0&&(var(49):=ceil(cond(!enemynear,hitFall, target,getHitVar(hittime), target,getHitVar(fall.recovertime))))
