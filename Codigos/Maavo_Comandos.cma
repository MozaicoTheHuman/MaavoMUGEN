ctrl = 1

[State -1, LEVANTATE GUEON]
type = SelfState
value = 5120
triggerall = aiLevel && roundstate = 2 && alive && numenemy
trigger1 = stateno = 5110 && time >= 0

;Guard
[State -1, AI Guard]
type = ChangeState
value = cond(statetype = A, 140, cond(enemynear,hitdefattr = C,NA,SA,HA,NP,SP,HP, 130, 120))
triggerall = aiLevel != 0 && roundstate = 2 && alive && numenemy
