;AI Lock
trigger5 = roundstate = 2 && ctrl
trigger5 = 0&&(var(58):=1)
trigger6 = roundstate != 2
trigger6 = 0&&(var(58):=0)
;GURT var(53)
trigger7 = anim = 5120 || roundstate != 2
trigger7 = 0&&(var(53):=12)
trigger8 = var(53) > 0 && anim != 5120 && roundstate = 2
trigger8 = 0&&(var(53):=var(53)-1)

[State -1, Null]
type = Null
;AI Probability
trigger1 = aiLevel && enemyNear,aiLevel > 0
trigger1 = 0&&(var(59):=ceil(200 * cond(life < lifemax*0.02, 4.0, cond(life < lifemax*0.10, 2.5, cond(life < lifemax*0.25, 1.8, cond(life < lifemax*0.50, 1.3, 1.0))))))
