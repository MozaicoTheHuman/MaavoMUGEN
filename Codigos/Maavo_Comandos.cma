trigger6 = 0&&(var(49):=0)
;Calc HitFall
trigger7 = 1
trigger7 = 0&&(var(37):=(enemynear,hitFall) || (var(49) > 8))
;Calc Grounded
trigger8 = 1
trigger8 = 0&&(var(51):=(enemynear,statetype = S) || (enemynear,statetype = C))
