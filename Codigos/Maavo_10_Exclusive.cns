;///////////////////////////////////////////////////////////////////////////
; Normals
;///////////////////////////////////////////////////////////////////////////

;Throw
[Statedef 810]
type    = S
movetype= A
physics = N
anim = 809
poweradd = 0
sprpriority = -1

[State 0, ChangeState]
type = VarSet
triggerall = numtarget(800)
triggerall = anim = 809 && time < 9
trigger1 = target(800), command = "y"
trigger1 = target(800), command = "holdfwd" || target(800), command = "holdback"
var(7) = 1
ignorehitpause = 1

[State 0, ChangeState]
type = ChangeState
triggerall = anim = 809 && animelemtime(3) > 0
trigger1 = numtarget(800) && var(7)
trigger2 = !numtarget(800)
value = 880
ctrl = 0
ignorehitpause = 1

[State 0, Width]
type = Width
trigger1 = !time
trigger2 = anim = 809 && animtime = 0
value = 50,0

[State 810, Holding fwd?]
type = VarSet
trigger1 = Time = 0
var(3) = command = "holdfwd"

[State 10, Bind 1]
type = TargetBind
triggerall = anim = 809
trigger1 = AnimElemtime(3) < 0
pos = 50.0, 0
id = 800

[State 10, Bind 2]
type = TargetBind
triggerall = anim = 809
trigger1 = AnimElem = 3
pos = 48.0, 0
id = 800

[State 10, Bind 3]
type = TargetBind
triggerall = anim = 809
trigger1 = AnimElem = 4
pos = 40.0, 0
id = 800

[State 0, Turn]
type = Turn
trigger1 = anim = 809 && animtime = 0
trigger1 = var(3) != 1
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 809 && animtime = 0
value = 810;cond(var(3),810,830)
[State 0, TargetState]
type = TargetState
triggerall = NumTarget(800)
triggerall = anim = 810
trigger1 = target(800), stateno != 820
value = 820
ID = 800
ignorehitpause = 1
persistent = 0
[State 0, EnvShake]
type = EnvShake
triggerall = anim = 810
trigger1 = animelem = 6
time=20
freq=175
ampl=-5
ignorehitpause = 1

[State 0, PlaySnd]
